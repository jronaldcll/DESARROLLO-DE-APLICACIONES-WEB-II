              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 1,\n  \"customerId\": {{customerId}},\n  \"correo\": \"{{correo}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sales/rabbit-reserve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales",
                "rabbit-reserve"
              ]
            },
            "description": "Flujo alternativo RabbitMQ. Mantiene la respuesta original de venta sin mensaje."
          },
          "response": []
        },
        {
          "name": "Actualizar venta",
          "request": {
