              "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 3,\n  \"customerId\": {{customerId}},\n  \"correo\": \"{{correo}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sales/{{saleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
